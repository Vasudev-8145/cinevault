Content-Type: application/json

{
    "username":"adminA",
    "email":"adminA@gmail.com",
    "password":"adminA123"
}

# api call for creating user
###
POST http://127.0.0.1:8000/film/register/
Content-Type: application/json

{
    "username":"userA",
    "email":"userA@gmail.com",
    "password":"userA123"
}

# api call for token authentication
###
POST http://127.0.0.1:8000/film/token/
Content-Type: application/json

{
    "username":"adminA",
    "password":"adminA123"
}


